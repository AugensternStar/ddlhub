# DDLHub 非敏感配置。账号密码一律存系统钥匙串，不进本文件。
# 复制为 .env 后按需修改；所有项都有默认值，不改也能启动（在设置页添加平台后使用）。

DDLHUB_PORT=8787
# local=只监听 127.0.0.1（默认，最安全）；lan=局域网+令牌（手机访问用）
DDLHUB_LISTEN=local
DDLHUB_TIMEZONE=Asia/Shanghai
# 数据目录：不要放在 OneDrive/坚果云等同步目录（WAL 会被同步器破坏）
DDLHUB_DATA_DIR=./data
# 每日自动同步时刻（24h 制，逗号分隔）
DDLHUB_SYNC_TIMES=08:00,21:00
# 自动同步间隔下限（分钟）。红线：配置低于 10 会被钳制到 10
DDLHUB_MIN_INTERVAL_MIN=10
# 提醒档位：minutes_before 正数，逗号分隔（10080=提前7天）
DDLHUB_REMINDER_OFFSETS=10080,4320,1440,360,60
# 1=主密码 vault 模式（无安全钥匙串后端时用；启动时在终端交互输入主密码，不落盘。
#    需交互终端，不适合开机自启——Windows 用户请保持 0 使用钥匙串模式）
DDLHUB_VAULT_MODE=0
# LAN 模式访问令牌（留空则首次启动自动生成并写回 .env）
DDLHUB_TOKEN=
# 1=本机访问也强制令牌交换（共享电脑场景；SEC-02）
DDLHUB_LOCAL_TOKEN=0
# SMTP 邮件渠道（DDLHUB_SMTP_PASS 建议留空，授权码存钥匙串：ddlhub/notify/smtp）
DDLHUB_SMTP_HOST=
DDLHUB_SMTP_PORT=465
DDLHUB_SMTP_USER=
DDLHUB_SMTP_PASS=
